# Trazaloop · PLANTILLA de variables de entorno
#
# Copia este archivo a .env.local y rellena los valores:
#     cp .env.example .env.local
#
# ESTE ARCHIVO SOLO CONTIENE NOMBRES. Nunca escribas valores reales aquí ni
# lo uses para compartir claves. .env.local está ignorado por git.
#
# Verificación de PRESENCIA (nunca de valores):
#     npm run precheck:env

# ---------------------------------------------------------------------------
# 1. OBLIGATORIAS en la APLICACIÓN — Production Y Preview
#    (las consume el código del producto; verificadas por precheck:env)
# ---------------------------------------------------------------------------

# URL del proyecto Supabase (https://<project-ref>.supabase.co).
# Production → proyecto de producción · Preview → proyecto de staging.
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA del proyecto (siempre sujeta a RLS). Nombre vigente.
# El nombre heredado NEXT_PUBLIC_SUPABASE_ANON_KEY se sigue aceptando como
# respaldo temporal, pero la variable principal es esta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA del proyecto. SOLO servidor y scripts administrativos.
# Nunca lleva prefijo NEXT_PUBLIC_ y jamás debe llegar al navegador.
# El nombre heredado SUPABASE_SERVICE_ROLE_KEY se sigue aceptando como
# respaldo temporal.
SUPABASE_SECRET_KEY=

# Kill switch GLOBAL del módulo Trazaloop Textiles (server-only).
# Solo "true" o "1" lo encienden. En PRODUCCIÓN debe ser: true
TEXTILES_MODULE_ENABLED=

# Kill switch GLOBAL del módulo Trazaloop Quality (server-only).
# Solo "true" o "1" lo encienden; cualquier otro valor lo deja APAGADO, y con
# el switch apagado /quality responde 404: el módulo no existe para nadie.
#
#   · Local y Staging (QUALITY-01) → true
#   · PRODUCCIÓN                   → sin definir (Quality no está lanzado)
#
# No lleva prefijo NEXT_PUBLIC_ a propósito: el navegador nunca conoce su
# valor, porque ocultar un botón jamás es la barrera de acceso.
QUALITY_MODULE_ENABLED=

# Kill switch del REGISTRO PÚBLICO (server-only). Solo "true" o "1" lo
# habilitan; ausencia o cualquier otro valor lo dejan DESHABILITADO.
#
#   · Production TÉCNICO (hito A) → false
#     Permite desplegar y verificar la infraestructura sin exponer
#     /register mientras siguen abiertos los gates de apertura comercial.
#   · Preview / staging          → true (o false si se quiere probar el
#     modo cerrado).
#
# Las personas INVITADAS pueden crear su cuenta aunque esté en false: el
# servidor verifica que la invitación exista, siga pendiente, no haya
# expirado y corresponda a ese correo.
#
# NO es un mecanismo de autorización por sí solo, y NUNCA lleva prefijo
# NEXT_PUBLIC_. Cambiar su valor exige un DEPLOYMENT NUEVO en Vercel.
PUBLIC_REGISTRATION_ENABLED=

# Secreto para firmar (HMAC) la cookie de empresa activa
# (lib/auth/active-organization.ts). Sin él la cookie viaja sin firma y el
# código emite una advertencia; en desarrollo local es tolerable, en
# Production y Preview es obligatorio.
# Generar con: openssl rand -base64 32
# DISTINTO en cada ambiente (staging y producción nunca comparten secreto).
ACTIVE_ORG_COOKIE_SECRET=

# URL pública de la app en este ambiente. La consumen el restablecimiento
# de contraseña, los enlaces de invitación y la compartición de pasaportes.
# NO decide el ambiente de despliegue (eso lo hacen VERCEL_TARGET_ENV /
# VERCEL_ENV): puede contener "vercel.app" en Production sin problema.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# 2. AUTOMÁTICAS de Vercel — NO las definas tú
#    Vercel las inyecta en cada build. Deciden el ambiente de despliegue y
#    el distintivo de la UI. Se listan aquí solo como referencia.
#      VERCEL_TARGET_ENV  → production | preview | development | <personalizado>
#      VERCEL_ENV         → production | preview | development
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 3. COMPATIBILIDAD HEREDADA (fallback temporal, server-safe)
#    Se aceptan si están, pero la configuración RECOMENDADA usa los nombres
#    vigentes de la sección 1. No las configures en instalaciones nuevas.
# ---------------------------------------------------------------------------

# Nombre heredado de la clave secreta.
SUPABASE_SERVICE_ROLE_KEY=

# Nombre heredado de la clave pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 4. NO se usan en v1.0.0 (Ruta A) — no las configures
#    Estas funciones están APLAZADAS a versiones posteriores y no existen
#    en el código. Ver docs/releases/V1.0.0_ROUTE_A_SCOPE.md
#      · Mercado Pago / pagos            (sin integración)
#      · Google Analytics 4 / Tag Manager (sin implementar)
#      · Correos de mercadeo              (sin implementar)
#    Si alguien añade una variable de estas al entorno, es señal de que se
#    está introduciendo una función fuera del alcance de v1.0.0.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 5. SOLO para SCRIPTS LOCALES del operador — NUNCA en Vercel
# ---------------------------------------------------------------------------

# Cadena de conexión directa a PostgreSQL, para verificaciones SQL de solo
# lectura (verify:prod, verify-empty-production.sql) y para la herramienta
# opcional cleanup:staging. Retírala del archivo al terminar.
SUPABASE_DB_URL=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo la PLANTILLA de variables (solo nombres, nunca valores)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# configuración LOCAL de Claude Code (específica de cada máquina)
.claude/settings.local.json

# caché del CLI de Supabase
supabase/.temp/

# T9F.5B.1 · artefactos accidentales de comandos `find` mal citados
-name*

# RH-01.6 · artefactos accidentales de redirigir la salida de `npm run <script>`
# a un archivo con el NOMBRE del script. Patrón acotado a la raíz y al prefijo
# "test:" (ningún archivo legítimo del repo lleva ':' en el nombre).
/test:*
/run
